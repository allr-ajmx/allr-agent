dist/
node_modules/
# One tree per surface: desktop keeps `target/`, the dev:ext:android / :ios
# scripts point CARGO_TARGET_DIR at `target-android/` / `target-ios/` so two
# concurrent `tauri dev` runs never block each other on Cargo's build lock.
src-tauri/target*/
# Track both generated mobile projects so our native customizations — activity
# subclasses, the Home bridge, manifest edits, the iOS asset catalog — are
# versioned and the mobile builds are reproducible. Each has its own nested
# .gitignore excluding the build output (gen/android: build/, .gradle, .cxx,
# local.properties, …; gen/apple: build/, Externals/, assets/, xcuserdata/).
# Tracking gen/apple is what makes an app-icon drift visible in a diff — the
# Hermes rebrand shipped an iOS build wearing the old icon precisely because
# nothing under gen/apple was reviewable. See scripts/sync-ios-icons.mjs.
src-tauri/gen/*
!src-tauri/gen/android/
!src-tauri/gen/apple/

# Vendored plugin build artifacts — the app's src-tauri/Cargo.lock is authoritative
src-tauri/plugins/*/target/
src-tauri/plugins/*/Cargo.lock
