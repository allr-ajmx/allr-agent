{
  "name": "@hermes/universal",
  "private": true,
  "version": "0.0.1",
  "description": "Hermes Universal — Tauri v2 client (desktop + Android + iOS from one codebase).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:prodweb": "vite build --mode benchmark && tauri dev --config src-tauri/tauri.prodweb.conf.json",
    "dev:ios": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target-ios\" tauri ios dev \"iPhone 17\"",
    "dev:ext:vite": "TAURI_DEV_HOST=${HERMES_DEV_HOST:-127.0.0.1} vite",
    "dev:ext:desktop": "tauri dev --config src-tauri/tauri.external-vite.conf.json",
    "dev:ext:android": "npm run adb:reverse && CARGO_TARGET_DIR=\"$PWD/src-tauri/target-android\" tauri android dev --host ${HERMES_DEV_HOST:-127.0.0.1} --config src-tauri/tauri.external-vite.conf.json",
    "dev:ext:ios": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target-ios\" tauri ios dev --config src-tauri/tauri.external-vite.conf.json",
    "android:init": "tauri android init",
    "android:dev": "npm run adb:reverse && CARGO_TARGET_DIR=\"$PWD/src-tauri/target-android\" tauri android dev --host ${HERMES_DEV_HOST:-127.0.0.1}",
    "adb:reverse": "adb reverse tcp:5176 tcp:5176 && adb reverse tcp:5177 tcp:5177 && adb reverse tcp:4317 tcp:4317 && adb reverse tcp:4318 tcp:4318",
    "android:build:debug": "CARGO_TARGET_DIR=\"$PWD/src-tauri/target-android\" tauri android build --debug",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && npm run lint:samples",
    "lint:samples": "cd ../../packages/hermes-sample-plugins && eslint .",
    "lint:fix": "eslint src/ --fix && cd ../../packages/hermes-sample-plugins && eslint . --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'bench/*.mjs' 'vite.config.ts'",
    "fix": "npm run lint:fix && npm run fmt",
    "check:js": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:js && npm run check:rust"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.2.20",
    "@assistant-ui/react": "0.14.26",
    "@assistant-ui/react-streamdown": "0.3.5",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@lezer/highlight": "^1.2.3",
    "@nanostores/react": "^1.1.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-haptics": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "dnd-core": "^14.0.1",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "ignore": "^7.0.6",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "motion": "12.42.0",
    "nanostores": "^1.4.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.4",
    "react-arborist": "^3.13.2",
    "react-dnd-html5-backend": "^14.1.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "react-shiki": "^0.9.3",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "unicode-animations": "^1.0.3",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vfile": "^6.0.3",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
