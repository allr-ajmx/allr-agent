<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext policy for every build type.

  Why a config rather than the `usesCleartextTraffic` manifest flag: on API 24+ —
  and minSdk here is 24 — `networkSecurityConfig` SUPERSEDES that flag entirely,
  so the two cannot be mixed. The flag stays in the manifest for documentation
  and is inert.

  Cleartext is permitted because the WebView has to navigate to whatever gateway
  the user configured for the OAuth sign-in (`src-tauri/src/oauth.rs`), and most
  self-hosted gateways are plain http on a LAN or Tailscale address that cannot
  carry a publicly trusted certificate. Refusing it made the release build fail
  the sign-in with net::ERR_CLEARTEXT_NOT_PERMITTED while the debug build
  worked; iOS carries the equivalent exception
  (`NSAllowsArbitraryLoadsInWebContent` in Info.ios.plist). The RFC 8252
  loopback redirect (127.0.0.1:<random port>) needs it as well. Everything else —
  the gateway REST/WS traffic — runs in Rust and is not governed by this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
