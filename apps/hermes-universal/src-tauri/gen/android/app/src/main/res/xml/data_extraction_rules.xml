<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup policy. `android:allowBackup="false"` no longer governs cloud
  backup or device-to-device transfer on its own, so both are excluded here too.

  Nothing is listed as included: an empty <cloud-backup>/<device-transfer> means
  nothing leaves the device. That is the intent — the app's private storage holds
  Keystore-encrypted credentials whose key does not travel with a backup, so a
  restored copy is unreadable anyway, and shipping it around is pure exposure.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
