{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes (MJX)",
  "version": "0.0.1",
  "identifier": "com.jaxmatrix.mjx-unofficial-hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hermes (MJX)",
        "width": 420,
        "height": 900,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' data: blob: hermes-media: http://hermes-media.localhost https://hermes-media.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; font-src 'self' data: tauri: asset: http://tauri.localhost https://tauri.localhost http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "developmentTeam": "6M43WS4436"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    }
  }
}
